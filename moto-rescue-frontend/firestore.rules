rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Profiles, roles, availability, ratings, and verification state are
      // server-authoritative. The Firebase Admin SDK bypasses these rules
      // after the backend verifies the caller's Firebase ID token.
      allow read, create, update, delete: if false;
    }

    match /rescueRequests/{requestId} {
      // Rescue state is server-authoritative. Firebase Admin SDK bypasses
      // client rules after the backend verifies the user's ID token and role.
      allow read, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
