# Web/iOS simulator: http://localhost:8083
# Android emulator: http://10.0.2.2:8083
# Physical device: http://YOUR_COMPUTER_LAN_IP:8083
# Leave unset in Expo Go development to derive the Metro/LAN host automatically.
# EXPO_PUBLIC_API_URL=http://localhost:8083
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Android development/production builds only. Use a Google Maps SDK for Android key
# restricted to package com.oguzumutcan.motorescue and the build certificate SHA-1.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
