{
  "expo": {
    "name": "MotoRescue",
    "slug": "moto-rescue",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "motorescue",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["location", "fetch"]
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0B132A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.oguzumutcan.motorescue"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B132A",
          "dark": {
            "backgroundColor": "#0B132A"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#FF9500"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MotoRescue uses your selected photo as your profile picture.",
          "cameraPermission": "MotoRescue uses your camera to take profile and verification photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MotoRescue needs your location in the background to match you with passengers and provide live ETAs while you drive.",
          "locationAlwaysPermission": "MotoRescue needs your location in the background to match you with passengers and provide live ETAs while you drive.",
          "locationWhenInUsePermission": "MotoRescue needs your location to show where you are on the map.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c9089634-a2e3-4fdd-980f-cf5d278e8087"
      }
    }
  }
}
